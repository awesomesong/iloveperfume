{
  "name": "next-server",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev --turbo -p 3001",
    "dev:server": "node server.js",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx 2>/dev/null",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:all": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx 2>/dev/null && stylelint \"src/**/*.css\"",
    "lint:purple": "grep -rn --include='*.tsx' --include='*.css' -E '#(0c0a14|1a1625|1a1825|1f1b29|2a2840|2d2040|3d3d8f|52526e|554466|5555aa|5c4a7a|5c5270|5c64a4|656598|6868a8|6b5b95|6b5c7d|7a80cc|7c5eb0|8a7a9e|9d8fb8|a898b8|a89ec4|b094e0|b5a8cc|c0c0e0|c8b4ff|d4c8e4|dcdcf0|ddd0f8|ddd0ff|ddd8e8|e8e0ff|e8e8f8|eaeaf8|ebe2ff|f5f2ff)' src || echo '보라계열 하드코딩 없음'",
    "postinstall": "prisma generate",
    "db:check": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "bash -c 'ESLINT_USE_FLAT_CONFIG=false eslint --max-warnings=0 \"$@\"' --"
    ],
    "src/**/*.css": [
      "stylelint"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.5.2",
    "@heroui/react": "^2.7.5",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.19",
    "@tanstack/react-query-devtools": "^5.59.19",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.3.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.5.0",
    "next": "^15.5.18",
    "next-auth": "^4.24.7",
    "next-cloudinary": "^6.6.2",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "quill-resize-module": "^2.1.3",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.51.4",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.0.1",
    "react-intersection-observer": "^9.13.1",
    "react-quill-new": "^3.4.6",
    "react-select": "^5.8.0",
    "sha1": "^1.1.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sha1": "^1.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "9.34.0",
    "eslint-config-next": "^15.5.18",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.35",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
