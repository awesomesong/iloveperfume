# Database (Supabase PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Socket Server
NEXT_PUBLIC_SOCKET_SERVER_URL=
# 소켓 연결 토큰 서명용 (/api/socket/token, 서버 전용) — socket-server의 SOCKET_AUTH_SECRET과 같은 값
# openssl rand -hex 32 로 생성
SOCKET_AUTH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Webhook
WEBHOOK_SECRET=

# Naver 검색 API (향수 뉴스 수집용 — 쇼핑 검색 API는 2026-07-31 종료되어 쓰지 않음)
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=
# 뉴스 수집에 별도 애플리케이션 키를 쓸 때만 설정 (없으면 위 키 사용)
# NAVER_NEWS_CLIENT_ID=
# NAVER_NEWS_CLIENT_SECRET=

# 향수 뉴스 크론 (/api/cron/perfume-news) — openssl rand -hex 32 로 생성
CRON_SECRET=
