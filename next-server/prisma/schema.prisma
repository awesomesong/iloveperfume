generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                String             @id @default(cuid())
  name              String?
  nickname          String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  profileImage      String?
  hashedPassword    String?
  role              String?
  provider          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  comments          Comment[]
  conversationReads ConversationRead[]
  fragranceReviews  FragranceReview[]
  fragrances        Fragrance[]
  messages          Message[]
  sessions          Session[]
  conversations     Conversation[]     @relation("ConversationToUser")
  scanResults       ScanResult[]
  quizSessions      QuizSession[]
}

model Conversation {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now())
  lastMessageAt     DateTime           @default(now())
  name              String?
  isGroup           Boolean?
  isAIChat          Boolean?           @default(false)
  aiAgentType       String?
  lastMessageId     String?
  memberKey         String?            @unique
  userIds           String[]           @default([])
  conversationReads ConversationRead[]
  messages          Message[]
  users             User[]             @relation("ConversationToUser")

  @@index([isGroup])
}

model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastSeenAt     DateTime     @default(now())
  lastSeenMsgId  String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId, lastSeenMsgId])
  @@index([conversationId, lastSeenAt])
}

model Message {
  id             String       @id @default(cuid())
  body           String?
  image          String?
  createdAt      DateTime     @default(now())
  type           String?
  isAIResponse   Boolean?     @default(false)
  isError        Boolean?     @default(false)
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, isAIResponse, createdAt])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum NewsCategory {
  RELEASE // 신제품·한정판 출시
  BRAND // 브랜드 론칭·팝업·매장
  TREND // 트렌드·시즌 추천
  INTERVIEW // 조향사 인터뷰·브랜드 스토리
}

enum NoticeStatus {
  PUBLISHED // 공개
  HIDDEN // 관리자가 내린 글
}

// 향수 뉴스 — /api/cron/perfume-news 파이프라인만 생성한다 (사용자 작성 없음)
model Notice {
  id          String       @id @default(cuid())
  title       String
  // LLM 요약 (일반 텍스트 — HTML 저장 금지)
  summary     String
  category    NewsCategory
  status      NoticeStatus @default(PUBLISHED)
  // 원문 링크 — unique로 중복 게시 차단
  sourceUrl   String       @unique
  sourceName  String
  // 기사 발행 시각
  publishedAt DateTime
  image       String[]     @default([])
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  comments    Comment[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([category, status, publishedAt(sort: Desc)])
}

model Comment {
  id          String   @id @default(cuid())
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorEmail String?
  noticeId    String?
  author      User?    @relation(fields: [authorEmail], references: [email])
  notice      Notice?  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

model FragranceReview {
  id            String   @id @default(cuid())
  fragranceSlug String
  text          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  authorEmail   String?
  author        User?    @relation(fields: [authorEmail], references: [email])

  @@index([fragranceSlug])
}

enum FragranceSource {
  USER // 사용자가 직접 등록
  AI_AGENT // 신제품 수집 파이프라인이 등록
}

model Fragrance {
  id          String                       @id @default(cuid())
  brand       String
  name        String
  slug        String                       @unique
  images      String[]
  description String
  notes       String?
  authorEmail String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  scoreA      Float?
  scoreB      Float?
  scoreC      Float?
  scoreD      Float?
  scoreE      Float?
  // pgvector는 Prisma 1급 지원 타입이 아니라 Unsupported로 표시만 — 실제 사용은 $queryRaw
  embedding   Unsupported("vector(1536)")?
  embeddedAt  DateTime?
  // 네이버 쇼핑 판매 여부 캐시 (7일 TTL) — { available, item, fetchedAt, koreanName }
  naverCache  Json?
  // 등록 경로 — USER: /fragrance/create, AI_AGENT: /api/cron/perfume-arrivals 파이프라인
  source      FragranceSource              @default(USER)
  // 브랜드 공식 제품 페이지. unique로 같은 제품의 중복 수집을 막는다 (사용자 등록 건은 null)
  officialUrl String?                      @unique
  author      User?                        @relation(fields: [authorEmail], references: [email])

  @@index([source, createdAt(sort: Desc)])
}

// 다시 수집하지 않을 공식 URL — 수집된 향수를 삭제할 때 기록한다 (틀린 내용은 남기지 않고 URL만 남긴다)
model FragranceBlockedUrl {
  id          String   @id @default(cuid())
  officialUrl String   @unique
  createdAt   DateTime @default(now())
}

enum ArrivalSourceKind {
  SHOPIFY // 상품 목록(/products.json)
  SITEMAP // 사이트맵 + 상품 페이지의 구조화 데이터
}

enum ArrivalSourceStatus {
  ACTIVE // 수집 중
  INACTIVE // 판정 전이거나 수집하지 않음 (reason에 사유)
}

enum ArrivalLeadStatus {
  PENDING // 공식 사이트를 아직 찾지 않음
  RESOLVED // 공식 사이트 후보를 ArrivalSource에 등록함
  UNRESOLVED // 공식 사이트를 찾지 못함
}

// 향수 신제품 수집 대상(브랜드 공식 사이트). 사람이 등록하지 않는다 — 파이프라인이 브랜드를 찾고(ArrivalBrandLead),
// 공식 사이트를 찾아 등록하고, 읽을 수 있는지 판정해 켜고 끈다. 한 브랜드에 후보 사이트가 여럿일 수 있고 그중 하나만 ACTIVE다.
model ArrivalSource {
  id              String              @id @default(cuid())
  // Fragrance.brand에 저장할 표기 (영문 대문자)
  brand           String
  // 표기 차이를 무시한 브랜드 키 — 같은 브랜드의 후보 사이트를 묶는다
  brandKey        String
  // 판매처에 적힌 다른 표기(한글 등) — 상품 이름 앞의 브랜드명을 떼는 데 쓴다
  aliases         String[]
  host            String              @unique
  // 상품을 읽는 방식. 판정 전에는 null
  kind            ArrivalSourceKind?
  status          ArrivalSourceStatus @default(INACTIVE)
  // 같은 브랜드의 후보 순서 — 0: 한국 공식몰, 1: 향수 전용 사이트, 2: 글로벌
  rank            Int                 @default(2)
  // 한국에서 살 수 있다고 본 근거 — 입점 판매처 이름 또는 "회원 등록"
  koreaBasis      String
  // 최근 판정·수집 결과 (왜 켜졌거나 꺼졌는지)
  reason          String?
  nextProbeAt     DateTime            @default(now())
  // 수집 연속 실패 횟수
  failCount       Int                 @default(0)
  // SITEMAP: 기존 상품 주소를 기준선으로 기록한 시각
  baselineAt      DateTime?
  lastCollectedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  seenUrls        ArrivalSeenUrl[]

  @@index([status, lastCollectedAt])
  @@index([nextProbeAt])
  @@index([brandKey])
}

// 사이트맵에서 본 상품 주소 — 게시일이 없는 사이트에서 "처음 본 날"로 신제품을 가린다
model ArrivalSeenUrl {
  sourceId    String
  url         String
  // 향수 단품인지. null이면 아직 열어 보지 않음
  perfume     Boolean?
  firstSeenAt DateTime
  source      ArrivalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, url])
}

// 수집 대상 후보 브랜드 — 국내 판매처 입점 브랜드와 회원이 등록한 향수의 브랜드
model ArrivalBrandLead {
  // 표기 차이를 무시한 브랜드 키
  key       String            @id
  name      String
  // 후보가 나온 곳 — 판매처 이름 또는 "회원 등록"
  origin    String
  examples  String[]
  status    ArrivalLeadStatus @default(PENDING)
  attempts  Int               @default(0)
  // 찾은 사이트 또는 찾지 못한 사유
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, attempts, createdAt])
}

model QuizSession {
  id               String   @id @default(cuid())
  shareCode        String   @unique
  userEmail        String?
  vectorA          Float
  vectorB          Float
  vectorC          Float
  vectorD          Float
  vectorE          Float
  characterId      String
  recommendedSlugs String[] @default([])
  answersJson      Json
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userEmail], references: [email])

  @@index([userEmail])
  @@index([shareCode])
  @@index([createdAt(sort: Desc)])
}

model FragranceKoreanName {
  id        String   @id @default(cuid())
  brand     String
  name      String
  korean    String
  createdAt DateTime @default(now())

  @@unique([brand, name])
  @@index([brand, name])
}

model ScanResult {
  id             String   @id @default(cuid())
  brand          String
  name           String
  notes          String?
  description    String?
  imageUrl       String
  imageWidth     Int?
  imageHeight    Int?
  matchedSlug    String?
  prices         Json?
  // 갤러리 유사 향수 캐시 (7일 TTL) — { items: SimilarFragrance[], fetchedAt }
  galleryCache   Json?
  // 네이버 구매 추천 캐시 (24h TTL) — { items: VerifiedSimilarFragrance[], fetchedAt }
  naverRecoCache Json?
  userEmail      String?
  tokensUsed     Int?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userEmail], references: [email])

  @@index([brand, name])
  @@index([userEmail])
  @@index([createdAt(sort: Desc)])
}
