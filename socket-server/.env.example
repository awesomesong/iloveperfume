# CORS 허용 도메인 (쉼표 구분)
CLIENT_ORIGIN=

# Webhook
WEBHOOK_SECRET=

# 포트
PORT=3002

# 소켓 연결 인증 — next-server의 SOCKET_AUTH_SECRET과 같은 값 (openssl rand -hex 32 로 생성)
SOCKET_AUTH_SECRET=
# "true"면 토큰 없는 연결을 거부한다. 그 외에는 배포 전환용 호환 모드(토큰 없는 구버전 클라이언트 허용).
# 전환 순서: 소켓 서버 배포(비워 둠) → Next 배포 → true로 설정
SOCKET_AUTH_REQUIRED=
