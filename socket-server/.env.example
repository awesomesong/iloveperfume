# CORS 허용 도메인 (쉼표 구분)
CLIENT_ORIGIN=

# Webhook — next-server의 WEBHOOK_SECRET과 같은 값
# /api/user-registered와 /internal/emit(Next API가 저장 후 메시지·이벤트 전달을 요청) 인증에 쓴다. 비우면 두 엔드포인트 모두 500
WEBHOOK_SECRET=

# 포트
PORT=3002

# 소켓 연결 인증(토큰 필수) — next-server의 SOCKET_AUTH_SECRET과 같은 값 (openssl rand -hex 32 로 생성). 비우면 모든 소켓 연결을 거부한다
SOCKET_AUTH_SECRET=
# 1이면 연결·해제·join·presence 같은 정상 이벤트도 로그로 남긴다 (로컬 디버깅용)
SOCKET_DEBUG=
